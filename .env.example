# Environment variable alternative / overrides for config.yaml
# Copy to .env and source it, or export manually.

# Server
DGX_SMD_HOST=127.0.0.1
DGX_SMD_PORT=7474
DGX_SMD_POLL_SECONDS=8
# DGX_SMD_TOKEN=change-me
DGX_SMD_CORS_ORIGIN=*
DGX_SMD_HEADROOM_GIB=2.0
DGX_SMD_UNITS=GiB

# Single-spark convenience (builds sparks[0])
# DGX_SMD_MODE=remote
# DGX_SMD_SPARK_ID=spark-1
# DGX_SMD_SPARK_LABEL=spark-1
# DGX_SMD_SPARK_HOST=100.x.x.x
# DGX_SMD_SPARK_USER=youruser
# DGX_SMD_SSH_KEY=~/.ssh/id_ed25519
# DGX_SMD_SSH_PORT=22

# Multi-spark one-liner (semicolon-separated):
# id|label|mode|user@host:port|key
# DGX_SMD_SPARKS="spark-1|spark-1|remote|user@100.1.1.1:22|~/.ssh/id_ed25519;spark-2|spark-2|remote|user@100.2.2.2:22|~/.ssh/id_ed25519"

# Menu bar companion
# DGX_SMD_URL=http://127.0.0.1:7474
# DGX_SMD_MENUBAR_POLL=15
